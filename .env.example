# Copy to .env and fill in only what your chosen providers need.
# Non-secret settings (models, base URLs, chunk sizes) live in config.yaml.

# Anthropic API (only if llm.provider is "anthropic")
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible server that requires a key (only if llm.provider is "openai")
# Local servers such as Ollama do not need one.
OPENAI_API_KEY=
